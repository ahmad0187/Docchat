# Copy to .env for local runs. On Hostinger, add these in hPanel -> your Node.js app -> Environment variables.

# --- AI keys (leave empty and set AI_MODE=mock to test offline) ---
ANTHROPIC_API_KEY=
# Embeddings: set ONE of these. Gemini has a free tier (key from aistudio.google.com, no card).
GEMINI_API_KEY=
OPENAI_API_KEY=
# AI_MODE=mock
# CLAUDE_MODEL=claude-haiku-5-5
# EMBED_PROVIDER=gemini        (or openai; picked automatically from the key you set)
# EMBED_MODEL=gemini-embedding-001   (or text-embedding-3-small for OpenAI)

# --- Supabase (leave empty to use in-memory storage for local testing) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Never put this key in the browser or in Git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Limits (optional, these are the defaults) ---
# PORT=3000
# MAX_FILE_MB=10
# MAX_DOCS_PER_WORKSPACE=20
# MAX_PAGES=300
# DEMO_QUESTIONS_PER_HOUR=20
# DEMO_QUESTIONS_PER_DAY_TOTAL=500
# USER_QUESTIONS_PER_HOUR=120
# TOP_K=5
# MIN_SIMILARITY=0.25
